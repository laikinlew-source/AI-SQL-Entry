# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/
ENV/

# Build and packaging output
build/
dist/
*.egg-info/
.eggs/

# Test, coverage, and type-checking caches
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/

# IDE and operating-system files
.idea/
.vscode/
.DS_Store
Thumbs.db

# Local runtime data
data/logs/*
!data/logs/.gitkeep
